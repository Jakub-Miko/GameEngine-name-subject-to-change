@Entity:Construction_Script



function OnConstruct() 

    CreateProperty_FLOAT("time", 0.0)
end



@Entity:Inline_Script



function OnUpdate(delta_time)

    SetTranslation(vec3(0.0,10,0))
    time = GetProperty_FLOAT("time")
    time = time + delta_time
    SetProperty_FLOAT("time", time)
    SetTranslation(vec3(math.sin(time/1000),0,0))
end






@EndSection
